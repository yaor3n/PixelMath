<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main-Template.master.cs" Inherits="PixelMath.Main_Template" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>PixelMath</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="PixelMath_Logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka+One&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <link rel="stylesheet" href="Main-CSS.css" />
    
    <%--Slot for individual pages to inject page-specific header tags if needed--%>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="dashboard" id="dashboard-app">
            <div class="dashboard-layout">
                
                <!-- Dark Overlay Mask for Mobile Viewports -->
                <div id="sidebarOverlayMask" class="sidebar-overlay" onclick="toggleSidebar(event)"></div>
                
                <%--Sidebar Layout--%>
                <aside class="sidebar">
                    <div class="sidebar-head">
                        <div class="sidebar-logo">
                            <img src="PixelMath_Logo.png" alt="PixelMath Logo"/>
                            <span class="website-name">PixelMath</span>
                        </div>
                    </div>

                    <div class="sidebar-user">
                        <div class="student-avatar">
                            <img src="Student-Avatar.png" width="200" height="200" alt="Avatar"/>
                        </div>
                        <div>
                            <div class="username" id="sidebar-name">
                                <asp:Label ID="FullName" runat="server"></asp:Label>
                            </div>
                            <div class="user-role">Student · <asp:Label ID="Form" runat="server"></asp:Label></div>
                        </div>
                    </div>

                    <div class="sidebar-category"> Main </div>
                    <a href="Student-Dashboard.aspx" class="sidebar-selection"><i class="fa-solid fa-house-chimney-window"></i>Dashboard</a>
                    <a href="Student-Announcements.aspx" class="sidebar-selection"><i class="fa-solid fa-bell"></i>Announcements</a>

                    <div class="sidebar-category"> Learning </div>
                    <a href="Student-Quiz.aspx" class="sidebar-selection"><i class="fa-solid fa-file-pen"></i>Take a Quiz</a>
                    <a href="Student-Previous-Quiz.aspx" class="sidebar-selection"><i class="fa-solid fa-hourglass"></i>Previous Quizzes</a>
                    <a href="Student-Result.aspx" class="sidebar-selection"><i class="fa-solid fa-square-poll-horizontal"></i>My Results</a>
                    <a href="Student-Resources.aspx" class="sidebar-selection"><i class="fa-solid fa-book"></i>Learning Resources</a>

                    <div class="sidebar-category"> Account </div>
                    <a href="Student-Profile.aspx" class="sidebar-selection"><i class="fa-solid fa-circle-user"></i>My Profile</a>
                   
                    <div class="sidebar-footer">
                        <button type="button" class="logout-btn" onclick="openModal()">
                            <i class="fa-solid fa-right-from-bracket"></i>Log out
                        </button>
                    </div>
                </aside>

                <%--Logout Confirmation Modal Box--%>
                <div id="logoutConfirmation" class="modal">
                    <div class="modal-content">
                        <div class="modal-icon"><i class="fa-solid fa-right-from-bracket"></i></div>
                        <h2>Logging Out?</h2>
                        <p>Are you sure you want to log out of PixelMath?</p>
                        <div class="modal-buttons">
                            <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
                            <asp:LinkButton ID="btnConfirmLogOut" runat="server" OnClick="btnConfirmLogOut_Click" CssClass="btn-confirm">
                                Log Out
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>

                <%-- Content Area Window Framework --%>
                <main class="main" id="main-content">
                    <div class="topbar">
                        <div style="display: flex; align-items: center; gap: 15px; width: 100%;">
                            <!-- 🎯 THE FULL RESPONSIVE TOGGLE ENGINE BUTTON -->
                            <button type="button" id="sidebarToggle" class="sidebar-toggle-btn" onclick="toggleSidebar(event)">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <div class="topbar-title">
                                <asp:ContentPlaceHolder ID="TopbarTitleContent" runat="server">
                                </asp:ContentPlaceHolder>
                            </div>
                        </div>
                    </div>
                    <div class="topbar-block"></div>
                    <div class="content">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </main>
            </div>
        </div>
    </form>

    <script>
        // --- Modal Display Rules ---
        function openModal() {
            // 1. Show the Logout Modal
            document.getElementById("logoutConfirmation").style.display = "flex";
            document.body.style.overflow = "hidden";

            // 🎯 FIX 2: Automatically close mobile sidebar & backdrop when opening logout modal
            var sidebar = document.querySelector(".sidebar");
            var overlay = document.getElementById("sidebarOverlayMask");

            if (sidebar && sidebar.classList.contains("open")) {
                sidebar.classList.remove("open");
            }
            if (overlay && overlay.classList.contains("visible")) {
                overlay.classList.remove("visible");
            }
        }

        function closeModal() {
            document.getElementById("logoutConfirmation").style.display = "none";
            document.body.style.overflow = "auto";
        }

        window.onclick = function (event) {
            var modal = document.getElementById("logoutConfirmation");
            if (event.target === modal) {
                closeModal();
            }
        }

        // --- Sidebar Menu Interactivity Engine ---
        function toggleSidebar(event) {
            if (event) event.stopPropagation();

            var sidebar = document.querySelector(".sidebar");
            var overlay = document.getElementById("sidebarOverlayMask");

            sidebar.classList.toggle("open");
            if (overlay) {
                overlay.classList.toggle("visible");
            }
        }

        // --- DOM Active Selection Mapping ---
        window.addEventListener("DOMContentLoaded", function () {
            var currentPage = window.location.pathname.split("/").pop();

            if (currentPage === "") {
                currentPage = "Student-Dashboard.aspx";
            }

            var sidebarLinks = document.querySelectorAll(".sidebar-selection");
            sidebarLinks.forEach(function (link) {
                var linkTarget = link.getAttribute("href");
                if (linkTarget === currentPage) {
                    link.classList.add("active");
                }

                // Clicking a menu item auto-closes the drawer panel panel smoothly on mobile viewports
                link.addEventListener("click", function () {
                    var sidebar = document.querySelector(".sidebar");
                    var overlay = document.getElementById("sidebarOverlayMask");
                    if (sidebar.classList.contains("open")) {
                        sidebar.classList.remove("open");
                        if (overlay) overlay.classList.remove("visible");
                    }
                });
            });
        });
    </script>
</body>
</html>