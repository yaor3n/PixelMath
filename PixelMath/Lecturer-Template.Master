<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Lecturer-Template.Master.cs" Inherits="PixelMath.Lecturer_Template" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>PixelMath Lecturer</title>
    <link rel="icon" type="image/png" href="PixelMath_Logo.png" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Fredoka+One&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="Main-CSS.css" />
    <link rel="stylesheet" href="Admin-CSS.css" />

    <style>
        /* Mobile Hamburger & Sidebar Drawer Styles */
        @media (max-width: 1023px) {
            .sidebar {
                position: fixed !important;
                top: 0;
                left: 0;
                height: 100vh;
                z-index: 1000;
                transform: translateX(-100%);
                transition: transform 0.3s ease-in-out;
                width: 260px;
            }
            .sidebar.mobile-open {
                transform: translateX(0) !important;
            }
        }

        /* Mobile Backdrop Overlay */
        #mobileBackdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.5);
            z-index: 999;
        }
        #mobileBackdrop.active {
            display: block;
        }

        /* Topbar Hamburger Button Styling */
        .hamburger-btn {
            display: none;
            background: transparent;
            border: none;
            font-size: 20px;
            color: #475569;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .hamburger-btn:hover {
            background: #f1f5f9;
        }
        @media (max-width: 1023px) {
            .hamburger-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-right: 12px;
            }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="dashboard" id="dashboard-app">
            <div class="dashboard-layout">

                <%-- Mobile Backdrop Overlay --%>
                <div id="mobileBackdrop" onclick="toggleMobileSidebar()"></div>

                <%--Sidebar--%>
                <aside class="sidebar" id="appSidebar">
                    <div class="sidebar-head flex justify-between items-center">
                        <div class="sidebar-logo">
                            <img src="PixelMath_Logo.png" alt="PixelMath Logo"/>
                            <span class="website-name">PixelMath</span>
                        </div>
                        <!-- Close button for mobile drawer -->
                        <button type="button" class="lg:hidden text-slate-400 hover:text-slate-600 p-2" onclick="toggleMobileSidebar()">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                    </div>

                    <div class="sidebar-user">
                        <div class="student-avatar">
                            <img src="Student-Avatar.png" width="200" height="200" alt="Avatar"/>
                        </div>
                        <div>
                            <div class="username" id="sidebar-name">
                                <asp:Literal ID="litSidebarLecturerName" runat="server"></asp:Literal>
                            </div>
                            <div class="user-role">Lecturer</div>
                        </div>
                    </div>

                    <div class="sidebar-category"> Main </div>
                    <a href="Lecturer-Dashboard.aspx" class="sidebar-selection"><i class="fa-solid fa-house-chimney-window"></i>Dashboard</a>

                    <div class="sidebar-category"> Management </div>
                    <a href="Lecturer-Announcements.aspx" class="sidebar-selection"><i class="fa-solid fa-bullhorn"></i>Announcements</a>
                    <a href="Lecturer-Create-Class.aspx" class="sidebar-selection"><i class="fa-solid fa-chalkboard-user"></i>Create Class</a>
                    <a href="Lecturer-Create-Quiz.aspx" class="sidebar-selection"><i class="fa-solid fa-circle-plus"></i>Create Quiz</a>
                    <a href="Lecturer-Manage-Quizzes.aspx" class="sidebar-selection"><i class="fa-solid fa-file-lines"></i>Manage Quizzes</a>
                    <a href="Lecturer-Marking.aspx" class="sidebar-selection"><i class="fa-solid fa-pen-to-square"></i>Grade Submissions</a>
                    <a href="Lecturer-Upload-Resources.aspx" class="sidebar-selection"><i class="fa-solid fa-cloud-arrow-up"></i>Upload Resources</a>

                    <div class="sidebar-category"> System </div>
                    <a href="Lecturer-Profile.aspx" class="sidebar-selection"><i class="fa-solid fa-user-gear"></i>Profile</a>

                    <div class="sidebar-footer">
                        <button type="button" class="logout-btn" onclick="openModal()">
                            <i class="fa-solid fa-right-from-bracket"></i>Log out
                        </button>
                    </div>
                </aside>

                <%--Logout popout--%>
                <div id="logoutConfirmation" class="modal">
                    <div class="modal-content">
                        <div class="modal-icon"><i class="fa-solid fa-right-from-bracket"></i></div>
                        <h2>Logging Out?</h2>
                        <p>Are you sure you want to log out of PixelMath?</p>
                        <div class="modal-buttons">
                            <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
                            <asp:LinkButton ID="btnConfirmLogOut" runat="server" OnClick="btnLogout_Click" CssClass="btn-confirm">
                                Log Out
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>

                <%-- Content Area --%>
                <main class="main" id="main-content">
                    <div class="topbar flex items-center px-4">
                        <!-- Hamburger Menu Button -->
                        <button type="button" class="hamburger-btn" onclick="toggleMobileSidebar()">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <div class="topbar-title">
                            <asp:ContentPlaceHolder ID="TopbarTitleContent" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </div>
                    <div class="topbar-block"></div>
                    <div class="content">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </main>
            </div>
        </div>
    </form>

    <script>
        // Toggle mobile sidebar drawer & backdrop
        function toggleMobileSidebar() {
            var sidebar = document.getElementById("appSidebar");
            var backdrop = document.getElementById("mobileBackdrop");

            sidebar.classList.toggle("mobile-open");
            backdrop.classList.toggle("active");

            if (sidebar.classList.contains("mobile-open")) {
                document.body.style.overflow = "hidden";
            } else {
                document.body.style.overflow = "auto";
            }
        }

        // Logout Modal Controls
        function openModal() {
            document.getElementById("logoutConfirmation").style.display = "flex";
            document.body.style.overflow = "hidden";
        }

        function closeModal() {
            document.getElementById("logoutConfirmation").style.display = "none";
            document.body.style.overflow = "auto";
        }

        window.onclick = function (event) {
            var modal = document.getElementById("logoutConfirmation");
            if (event.target === modal) {
                closeModal();
            }
        }

        // Active link highlighting & automatic drawer close on mobile link click
        window.addEventListener("DOMContentLoaded", function () {
            var currentPage = window.location.pathname.split("/").pop();

            if (currentPage === "") {
                currentPage = "Lecturer-Dashboard.aspx";
            }

            var sidebarLinks = document.querySelectorAll(".sidebar-selection");

            sidebarLinks.forEach(function (link) {
                var linkTarget = link.getAttribute("href");
                if (linkTarget === currentPage) {
                    link.classList.add("active");
                }

                // Close mobile sidebar when clicking any navigation link
                link.addEventListener("click", function () {
                    if (window.innerWidth <= 1023) {
                        toggleMobileSidebar();
                    }
                });
            });
        });
    </script>
</body>
</html>